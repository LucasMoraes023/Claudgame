<?xml version="1.0" encoding="utf-8"?>
<!-- fitsSystemWindows: no Android 15 (targetSdk 35) o app é desenhado de ponta a ponta;
     sem isso o título ficava sob a barra de status e os botões sob a barra de navegação. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cg_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hub_title"
            android:textColor="@color/cg_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/hub_subtitle"
            android:textColor="@color/cg_cyan"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/panel_bg"
            android:padding="18dp"
            android:text="@string/hub_ready"
            android:textColor="@color/cg_text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/hub_game_section"
            android:textColor="@color/cg_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/gameSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_bg"
            android:contentDescription="@string/hub_spinner_label"
            android:popupBackground="@drawable/popup_bg"
            android:spinnerMode="dropdown" />

        <Button
            android:id="@+id/playButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/btn_primary"
            android:stateListAnimator="@null"
            android:text="@string/hub_play"
            android:textAllCaps="false"
            android:textColor="@color/cg_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/aiButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_secondary"
            android:stateListAnimator="@null"
            android:text="@string/hub_ai_start"
            android:textAllCaps="false"
            android:textColor="@color/cg_cyan"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/trollButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_secondary"
            android:stateListAnimator="@null"
            android:text="@string/hub_troll_off"
            android:textAllCaps="false"
            android:textColor="@color/cg_muted"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/hub_info"
            android:textColor="@color/cg_muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>